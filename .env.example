# Supabase configuration
# Copy to .env and fill in your Supabase project values
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# CAKTO checkout
# Paste the product checkout link from your CAKTO dashboard
# e.g. https://pay.cakto.com.br/seu-produto
VITE_CAKTO_CHECKOUT_URL=https://pay.cakto.com.br/seu-produto
